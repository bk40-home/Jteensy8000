	<div class="legend v-seq" style="left:1232dp; top:1876dp; width:159dp; text-align:left;">DESTINATION</div>
	<combo class="combo v-seq" param="seq.destination" key="seq.destination" default="0.0" options="None, Pitch, Filter, PWM, Amp" index="0" style="left:1232dp; top:1906dp; width:159dp; height:41dp;"/>
	<div class="legend v-seq" style="left:1425dp; top:1876dp; width:144dp; text-align:center;">RATE</div>
	<knob class="knob v-seq" param="seq.rate" key="seq.rate" default="0.5" style="left:1425dp; top:1906dp; width:144dp; height:144dp;"/>
	<div class="legend v-seq" style="left:1595dp; top:1876dp; width:164dp; text-align:left;">TIMING MODE</div>
	<combo class="combo v-seq" param="seq.timing_mode" key="seq.timing_mode" default="0.0" options="Free, 4 Bars, 2 Bars, 1 Bar, 1/2, 1/4, 1/8, 1/16, 1/32, 1/4T, 1/8T, 1/16T" index="0" style="left:1595dp; top:1906dp; width:164dp; height:41dp;"/>
	<div class="legend v-seq" style="left:1793dp; top:1876dp; width:144dp; text-align:center;">AUX DEPTH</div>
	<knob class="knob v-seq" param="seq.aux_depth" key="seq.aux_depth" default="0.5" style="left:1793dp; top:1906dp; width:144dp; height:144dp;"/>
	<div class="legend v-seq" style="left:1963dp; top:1876dp; width:209dp; text-align:left;">AUX DESTINATION</div>
	<combo class="combo v-seq" param="seq.aux_destination" key="seq.aux_destination" default="0.0" options="None, Filter, Pan, DelaySend, Drive" index="0" style="left:1963dp; top:1906dp; width:209dp; height:41dp;"/>
	<stepgrid class="stepgrid v-seq" param="" key="step_sequencer.pattern" lanes="2" steps="16" stepprefix="seq.step_,seq.aux_step_" style="left:2206dp; top:1906dp; width:1440dp; height:171dp;"/>

	<!-- Arpeggiator -->
	<div class="sectitle v-arp" style="left:56dp; top:1772dp; width:3728dp; text-align:left;">ARPEGGIATOR</div>
	<div class="legend v-arp" style="left:66dp; top:1876dp; width:96dp; text-align:left;">ENABLE</div>
	<toggle class="toggle v-arp" param="arp.enable" key="arp.enable" default="0.0" style="left:66dp; top:1906dp; width:96dp; height:72dp;"/>
	<div class="legend v-arp" style="left:188dp; top:1876dp; width:96dp; text-align:left;">LATCH</div>
	<toggle class="toggle v-arp" param="arp.latch" key="arp.latch" default="0.0" style="left:188dp; top:1906dp; width:96dp; height:72dp;"/>
	<div class="legend v-arp" style="left:310dp; top:1876dp; width:198dp; text-align:left;">MODE</div>
	<combo class="combo v-arp" param="arp.mode" key="arp.mode" default="0.0" options="Up, Down, UpDn Inc, UpDn Exc, AsPlayed, Random, Chord" index="0" style="left:310dp; top:1906dp; width:198dp; height:41dp;"/>
	<div class="legend v-arp" style="left:534dp; top:1876dp; width:129dp; text-align:left;">OCTAVES</div>
	<combo class="combo v-arp" param="arp.octaves" key="arp.octaves" default="0.0" options="1, 2, 3, 4" index="0" style="left:534dp; top:1906dp; width:129dp; height:41dp;"/>
	<div class="legend v-arp" style="left:697dp; top:1876dp; width:144dp; text-align:center;">FREE HZ</div>
	<knob class="knob v-arp" param="arp.free_hz" key="arp.free_hz" default="0.5" style="left:697dp; top:1906dp; width:144dp; height:144dp;"/>
	<div class="legend v-arp" style="left:867dp; top:1876dp; width:144dp; text-align:center;">GATE LENGTH</div>
	<knob class="knob v-arp" param="arp.gate_length" key="arp.gate_length" default="0.5" style="left:867dp; top:1906dp; width:144dp; height:144dp;"/>
	<div class="legend v-arp" style="left:1037dp; top:1876dp; width:144dp; text-align:center;">SWING</div>
	<knob class="knob v-arp" param="arp.swing" key="arp.swing" default="0.5" style="left:1037dp; top:1906dp; width:144dp; height:144dp;"/>
	<div class="legend v-arp" style="left:1207dp; top:1876dp; width:164dp; text-align:left;">RATE</div>
	<combo class="combo v-arp" param="arp.rate" key="arp.rate" default="0.6364" options="Free, 4 Bars, 2 Bars, 1 Bar, 1/2, 1/4, 1/8, 1/16, 1/32, 1/4T, 1/8T, 1/16T" index="0" style="left:1207dp; top:1906dp; width:164dp; height:41dp;"/>
	<div class="legend v-arp" style="left:1397dp; top:1876dp; width:144dp; text-align:center;">STEP COUNT</div>
	<knob class="knob v-arp" param="arp.step_count" key="arp.step_count" default="1.0" style="left:1397dp; top:1906dp; width:144dp; height:144dp;"/>
	<stepgrid class="stepgrid v-arp" param="" key="arpeggiator.pattern" lanes="1" steps="16" stepprefix="arp.step_accent_" style="left:1575dp; top:1906dp; width:1980dp; height:180dp;"/>

</body>
</rml>